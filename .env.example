ENV=development

# OpenAI
OPENAI_API_KEY=sk-...

# AWS
AWS_REGION=ap-northeast-1
S3_BUCKET=thumbnailai-dev
SQS_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/123456789/thumbnailai-dev

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/thumbnailai

# Internal service auth (shared with Go API)
INTERNAL_API_SECRET=change-me-in-production

# AI Models
SD_MODEL_ID=stabilityai/stable-diffusion-xl-base-1.0
CLIP_MODEL_ID=openai/clip-vit-large-patch14
SAM_MODEL_CHECKPOINT=sam_vit_h_4b8939.pth
